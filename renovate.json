{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:all",
    ":dependencyDashboard",
    "schedule:daily"
  ],
  "commitMessageExtra": "{{{currentValue}}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "packageRules": [
    {
      "description": "compose-ai-tools ships the preview Gradle plugin, the preview-annotations artifact and the `apply` GitHub Action as one release, and compose-preview.yml / compose-preview-publish.yml pin that action to a release commit while design-artifacts.yml resolves the renderer from the `composeAiTools` version-catalog key (cli-version: catalog). The two must name the same release or the PR render and the catalog publish run different renderers, so they are grouped into one PR here. Ungrouped from `group:all` and off the daily batching window as well: folded into the single all-dependencies PR, a renderer bump only lands when every unrelated dependency in that PR is green.",
      "matchPackageNames": [
        "yschimke/compose-ai-tools",
        "/^ee\\.schimke\\.composeai($|[.:])/"
      ],
      "groupName": "compose-ai-tools",
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchPackagePatterns": [
        "androidx.compose.compiler:compiler"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "androidx.compose:compose-bom"
      ],
      "allowedVersions": "/-alpha/"
    },
    {
      "matchPackagePatterns": [
        "org.jetbrains.kotlin.*"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "com.google.devtools.ksp"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "org.jetbrains.kotlinx:kotlinx-serialization-.*"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "com.mikepenz:multiplatform-markdown-renderer"
      ],
      "allowedVersions": "/coil2/"
    },
    {
      "matchPackagePatterns": [
        "com.google.protobuf:protobuf-kotlin-lite",
        "com.google.protobuf:protoc"
      ],
      "allowedVersions": "<=4.26.1"
    },
    {
      "matchPackagePatterns": [
        "androidx.datastore:*"
      ],
      "allowedVersions": "<=1.1.4"
    },
    {
      "matchPackagePatterns": [
        "androidx.core:*"
      ],
      "allowedVersions": "<1.19.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.lifecycle:*"
      ],
      "allowedVersions": "<2.11.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.hilt:*"
      ],
      "allowedVersions": "<1.4.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.compose.animation:*"
      ],
      "allowedVersions": "<1.12.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.compose.runtime:runtime-tracing"
      ],
      "allowedVersions": "<1.12.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "com.google.android.gms:play-services-auth"
      ],
      "allowedVersions": "<22.0.0",
      "description": "22.0.0 removed legacy GoogleSignIn APIs used by auth:data and auth:ui"
    },
    {
      "matchPackagePatterns": [
        "androidx.navigation:*"
      ],
      "allowedVersions": "<2.10.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "com.squareup.okhttp3:*"
      ],
      "allowedVersions": "<5.5.0",
      "description": "Requires compileSdk 37"
    }
  ]
}
