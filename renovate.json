{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:all",
    ":dependencyDashboard",
    "schedule:daily"
  ],
  "commitMessageExtra": "{{{currentValue}}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}",
  "packageRules": [
    {
      "groupName": "compose-ai-tools",
      "description": "yschimke/compose-ai-tools ships the preview Gradle plugin, compose-ai-tools-bom, and the reusable CI actions as one release. Ungrouped from `group:all` and off the daily batching window.",
      "matchPackageNames": [
        "yschimke/compose-ai-tools",
        "ee.schimke.composeai.preview",
        "ee.schimke.composeai:compose-ai-tools-bom"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "groupName": "compose-preview-daemon",
      "description": "yschimke/compose-preview-daemon BOM on its own 3.x release line.",
      "matchPackageNames": [
        "ee.schimke.composeai:compose-preview-daemon-bom"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "groupName": "compose-preview-contracts",
      "description": "yschimke/compose-preview-contracts BOM on its own release line.",
      "matchPackageNames": [
        "ee.schimke.composeai:compose-preview-contracts-bom"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "groupName": "compose-preview-ui-builder",
      "description": "yschimke/compose-preview-server UI builder BOM on its own release line.",
      "matchPackageNames": [
        "ee.schimke.composeai:compose-preview-ui-builder-bom"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "groupName": "rc-players",
      "description": "yschimke/rc-players BOM on its own release line.",
      "matchPackageNames": [
        "ee.schimke.composeai:rc-players-bom"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchPackagePatterns": [
        "androidx.compose.compiler:compiler"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "androidx.compose:compose-bom"
      ],
      "allowedVersions": "/-alpha/"
    },
    {
      "matchPackagePatterns": [
        "org.jetbrains.kotlin.*"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "com.google.devtools.ksp"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "org.jetbrains.kotlinx:kotlinx-serialization-.*"
      ],
      "groupName": "kotlin"
    },
    {
      "matchPackagePatterns": [
        "com.mikepenz:multiplatform-markdown-renderer"
      ],
      "allowedVersions": "/coil2/"
    },
    {
      "matchPackagePatterns": [
        "com.google.protobuf:protobuf-kotlin-lite",
        "com.google.protobuf:protoc"
      ],
      "allowedVersions": "<=4.26.1"
    },
    {
      "matchPackagePatterns": [
        "androidx.datastore:*"
      ],
      "allowedVersions": "<=1.1.4"
    },
    {
      "matchPackagePatterns": [
        "androidx.core:*"
      ],
      "allowedVersions": "<1.19.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.lifecycle:*"
      ],
      "allowedVersions": "<2.11.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.hilt:*"
      ],
      "allowedVersions": "<1.4.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.compose.animation:*"
      ],
      "allowedVersions": "<1.12.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "androidx.compose.runtime:runtime-tracing"
      ],
      "allowedVersions": "<1.12.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "com.google.android.gms:play-services-auth"
      ],
      "allowedVersions": "<22.0.0",
      "description": "22.0.0 removed legacy GoogleSignIn APIs used by auth:data and auth:ui"
    },
    {
      "matchPackagePatterns": [
        "androidx.navigation:*"
      ],
      "allowedVersions": "<2.10.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "com.squareup.okhttp3:*"
      ],
      "allowedVersions": "<5.5.0",
      "description": "Requires compileSdk 37"
    },
    {
      "matchPackagePatterns": [
        "org.robolectric:*"
      ],
      "allowedVersions": "<4.17",
      "description": "4.17 renders DatePickerA11yTest.interactionTest non-deterministically (the 'Next' button edge is anti-aliased differently between identical runs), so verifyRoborazziDebug flakes. It also needs --add-opens=java.base/jdk.internal.access=ALL-UNNAMED on the unit test JVM."
    }
  ]
}
